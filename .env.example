# Server-side environment variables for the Express API server.
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── OCR / LLM provider (required for timetable image extraction) ──────────────
# The server uses an OpenAI-compatible chat-completions API.
# Point BUILT_IN_FORGE_API_URL at any compatible endpoint
# (OpenAI, Google Gemini via OpenAI-compat proxy, etc.).
BUILT_IN_FORGE_API_URL=https://api.openai.com
BUILT_IN_FORGE_API_KEY=your-api-key-here

# ── Optional server settings ──────────────────────────────────────────────────
# Port the Express API server listens on (default: 3000)
# PORT=3000

# Session cookie signing secret
# JWT_SECRET=change-me-in-production

# OAuth provider URLs (not required for local timetable import)
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=

# ── Client-side public variables (Expo / React Native) ────────────────────────
# Override the auto-detected API base URL (useful for non-localhost deployments).
# On localhost the app automatically calls http://localhost:3000.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
